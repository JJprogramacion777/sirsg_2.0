# Copia este archivo como .env y rellena con los datos de tu proyecto Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Ruta secreta del panel de administración (RF-09). Cámbiala por algo difícil de adivinar.
VITE_ADMIN_PATH=/panel-sirsg-xyz

# Minutos de inactividad antes de cerrar la sesión del admin (RF-12)
VITE_ADMIN_IDLE_MINUTES=20

# CAPTCHA de Cloudflare Turnstile para el contacto y el login (RF-08, RF-11).
# Clave pública (site key). Para desarrollo sirve la de prueba de Cloudflare, que siempre aprueba:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# La clave secreta NO va aquí: se guarda en Supabase con
#   supabase secrets set TURNSTILE_SECRET_KEY=...
# (la de prueba que siempre aprueba es 1x0000000000000000000000000000000AA)
